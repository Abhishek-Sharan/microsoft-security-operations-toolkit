{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "defaultSubscriptionId": { "type": "String" },
    "defaultResourceGroupName": { "type": "String" },
    "defaultWorkspaceName": { "type": "String" },
    "sentinelWorkspaceCustomerId": { "type": "String" }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subscriptionId": { "type": "string" },
            "resourceGroupName": { "type": "string" },
            "workspaceName": { "type": "string" },
            "incidentId": { "type": "string" },
            "incidentNumber": { "type": "integer" },
            "reportVersion": { "type": "string" },
            "generatedUtc": { "type": "string", "format": "date-time" },
            "commentBody": { "type": "string" },
            "mode": { "type": "string", "enum": ["update-or-create"] },
            "marker": { "type": "string", "default": "=== INCIDENT TRIAGE REPORT ===" }
          },
          "required": [
            "subscriptionId",
            "resourceGroupName",
            "workspaceName",
            "incidentId",
            "incidentNumber",
            "reportVersion",
            "generatedUtc",
            "commentBody",
            "mode"
          ]
        }
      }
    }
  },
  "actions": {
    "Initialize_status": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [{ "name": "status", "type": "string", "value": "Failed-Unknown" }]
      },
      "runAfter": {}
    },
    "Initialize_attempts": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [{ "name": "attempts", "type": "integer", "value": 0 }]
      },
      "runAfter": { "Initialize_status": ["Succeeded"] }
    },
    "Initialize_marker": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [{
          "name": "marker",
          "type": "string",
          "value": "@coalesce(triggerBody()?['marker'], '=== INCIDENT TRIAGE REPORT ===')"
        }]
      },
      "runAfter": { "Initialize_attempts": ["Succeeded"] }
    },
    "Initialize_reportVersion": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [{
          "name": "reportVersion",
          "type": "string",
          "value": "@triggerBody()?['reportVersion']"
        }]
      },
      "runAfter": { "Initialize_marker": ["Succeeded"] }
    },
    "Initialize_incidentResourceName": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [{
          "name": "incidentResourceName",
          "type": "string",
          "value": "@string(triggerBody()?['incidentId'])"
        }]
      },
      "runAfter": { "Initialize_reportVersion": ["Succeeded"] }
    },
    "Condition_Resolve_incident_number": {
      "type": "If",
      "expression": "@or(empty(variables('incidentResourceName')), equals(variables('incidentResourceName'), string(triggerBody()?['incidentNumber'])), not(contains(variables('incidentResourceName'), '-')))",
      "actions": {
        "HTTP_Query_incident_by_number": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@concat('https://api.loganalytics.io/v1/workspaces/', parameters('sentinelWorkspaceCustomerId'), '/query')",
            "headers": { "Content-Type": "application/json" },
            "body": {
              "query": "@concat('SecurityIncident | where IncidentNumber == ', string(triggerBody()?['incidentNumber']), ' | summarize arg_max(TimeGenerated, *) by IncidentNumber | project IncidentName')"
            },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://api.loganalytics.io"
            },
            "retryPolicy": { "type": "exponential", "count": 2, "interval": "PT10S" }
          },
          "runAfter": {}
        },
        "Condition_Incident_Number_Found": {
          "type": "If",
          "expression": {
            "greater": ["@length(first(body('HTTP_Query_incident_by_number')?['tables'])?['rows'])", 0]
          },
          "actions": {
            "Set_incidentResourceName_from_number": {
              "type": "SetVariable",
              "inputs": {
                "name": "incidentResourceName",
                "value": "@first(first(body('HTTP_Query_incident_by_number')?['tables'])?['rows'])?[0]"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Set_status_incident_not_found": {
                "type": "SetVariable",
                "inputs": { "name": "status", "value": "Failed-IncidentNotFound" },
                "runAfter": {}
              }
            }
          },
          "runAfter": { "HTTP_Query_incident_by_number": ["Succeeded"] }
        }
      },
      "else": { "actions": {} },
      "runAfter": { "Initialize_incidentResourceName": ["Succeeded"] }
    },
    "HTTP_List_comments": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "@concat('https://management.azure.com/subscriptions/', coalesce(triggerBody()?['subscriptionId'], parameters('defaultSubscriptionId')), '/resourceGroups/', coalesce(triggerBody()?['resourceGroupName'], parameters('defaultResourceGroupName')), '/providers/Microsoft.OperationalInsights/workspaces/', coalesce(triggerBody()?['workspaceName'], parameters('defaultWorkspaceName')), '/providers/Microsoft.SecurityInsights/incidents/', variables('incidentResourceName'), '/comments?api-version=2023-11-01')",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://management.azure.com/"
        },
        "retryPolicy": { "type": "exponential", "count": 2, "interval": "PT10S" }
      },
      "runAfter": {
        "Condition_Resolve_incident_number": ["Succeeded", "Failed", "TimedOut", "Skipped"]
      }
    },
    "Condition_List_succeeded": {
      "type": "If",
      "expression": {
        "and": [
          { "greaterOrEquals": ["@outputs('HTTP_List_comments')?['statusCode']", 200] },
          { "less": ["@outputs('HTTP_List_comments')?['statusCode']", 400] }
        ]
      },
      "actions": {
        "Filter_Automation_Comment": {
          "type": "Query",
          "inputs": {
            "from": "@body('HTTP_List_comments')?['value']",
            "where": "@contains(coalesce(item()?['properties']?['message'], ''), variables('marker'))"
          },
          "runAfter": {}
        },
        "Set_commentTarget": {
          "type": "Compose",
          "inputs": "@if(greater(length(body('Filter_Automation_Comment')), 0), coalesce(first(body('Filter_Automation_Comment'))?['name'], last(split(first(body('Filter_Automation_Comment'))?['id'], '/'))), guid())",
          "runAfter": { "Filter_Automation_Comment": ["Succeeded"] }
        },
        "Increment_attempts": {
          "type": "IncrementVariable",
          "inputs": { "name": "attempts", "value": 1 },
          "runAfter": { "Set_commentTarget": ["Succeeded"] }
        },
        "HTTP_Upsert_comment": {
          "type": "Http",
          "inputs": {
            "method": "PUT",
            "uri": "@concat('https://management.azure.com/subscriptions/', coalesce(triggerBody()?['subscriptionId'], parameters('defaultSubscriptionId')), '/resourceGroups/', coalesce(triggerBody()?['resourceGroupName'], parameters('defaultResourceGroupName')), '/providers/Microsoft.OperationalInsights/workspaces/', coalesce(triggerBody()?['workspaceName'], parameters('defaultWorkspaceName')), '/providers/Microsoft.SecurityInsights/incidents/', variables('incidentResourceName'), '/comments/', outputs('Set_commentTarget'), '?api-version=2023-11-01')",
            "headers": { "Content-Type": "application/json" },
            "body": { "properties": { "message": "@triggerBody()?['commentBody']" } },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://management.azure.com/"
            },
            "retryPolicy": { "type": "exponential", "count": 2, "interval": "PT10S" }
          },
          "runAfter": { "Increment_attempts": ["Succeeded"] }
        },
        "Set_status_after_upsert": {
          "type": "SetVariable",
          "inputs": {
            "name": "status",
            "value": "@if(or(equals(outputs('HTTP_Upsert_comment')?['statusCode'], 401), equals(outputs('HTTP_Upsert_comment')?['statusCode'], 403)), 'Failed-Authorization', if(or(equals(outputs('HTTP_Upsert_comment')?['statusCode'], 404), equals(outputs('HTTP_Upsert_comment')?['statusCode'], 501)), 'Failed-ToolUnavailable', if(and(greaterOrEquals(outputs('HTTP_Upsert_comment')?['statusCode'], 200), less(outputs('HTTP_Upsert_comment')?['statusCode'], 400)), if(greater(length(body('Filter_Automation_Comment')), 0), 'Done-UpdatedExisting', 'Done-CreatedNew'), 'Failed-Unknown')))"
          },
          "runAfter": { "HTTP_Upsert_comment": ["Succeeded", "Failed", "TimedOut"] }
        }
      },
      "else": {
        "actions": {
          "Set_status_after_list_failure": {
            "type": "SetVariable",
            "inputs": {
              "name": "status",
              "value": "@if(or(equals(outputs('HTTP_List_comments')?['statusCode'], 401), equals(outputs('HTTP_List_comments')?['statusCode'], 403)), 'Failed-Authorization', if(or(equals(outputs('HTTP_List_comments')?['statusCode'], 404), equals(outputs('HTTP_List_comments')?['statusCode'], 501)), 'Failed-ToolUnavailable', 'Failed-Unknown'))"
            },
            "runAfter": {}
          }
        }
      },
      "runAfter": { "HTTP_List_comments": ["Succeeded", "Failed", "TimedOut"] }
    },
    "HTTP_Verify_comments": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "@concat('https://management.azure.com/subscriptions/', coalesce(triggerBody()?['subscriptionId'], parameters('defaultSubscriptionId')), '/resourceGroups/', coalesce(triggerBody()?['resourceGroupName'], parameters('defaultResourceGroupName')), '/providers/Microsoft.OperationalInsights/workspaces/', coalesce(triggerBody()?['workspaceName'], parameters('defaultWorkspaceName')), '/providers/Microsoft.SecurityInsights/incidents/', variables('incidentResourceName'), '/comments?api-version=2023-11-01')",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://management.azure.com/"
        },
        "retryPolicy": { "type": "exponential", "count": 2, "interval": "PT10S" }
      },
      "runAfter": { "Condition_List_succeeded": ["Succeeded"] }
    },
    "Filter_Verification": {
      "type": "Query",
      "inputs": {
        "from": "@body('HTTP_Verify_comments')?['value']",
        "where": "@and(contains(coalesce(item()?['properties']?['message'], ''), variables('marker')), contains(coalesce(item()?['properties']?['message'], ''), variables('reportVersion')))"
      },
      "runAfter": { "HTTP_Verify_comments": ["Succeeded"] }
    },
    "Condition_Verified": {
      "type": "If",
      "expression": "@greater(length(coalesce(body('Filter_Verification'), createArray())), 0)",
      "actions": {},
      "else": {
        "actions": {
          "Set_status_validation_failed": {
            "type": "SetVariable",
            "inputs": { "name": "status", "value": "Failed-Validation" },
            "runAfter": {}
          }
        }
      },
      "runAfter": { "Filter_Verification": ["Succeeded", "Failed", "TimedOut", "Skipped"] }
    },
    "Response": {
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": "@if(startsWith(variables('status'), 'Done-'), 200, 500)",
        "headers": { "Content-Type": "application/json" },
        "body": {
          "status": "@variables('status')",
          "verified": "@startsWith(variables('status'), 'Done-')",
          "incidentId": "@variables('incidentResourceName')",
          "incidentNumber": "@triggerBody()?['incidentNumber']",
          "reportVersion": "@variables('reportVersion')",
          "generatedUtc": "@triggerBody()?['generatedUtc']",
          "commentTarget": "@coalesce(outputs('Set_commentTarget'), 'unknown')",
          "commentUpdateAttempts": "@variables('attempts')",
          "errorCode": "@if(startsWith(variables('status'), 'Done-'), '', variables('status'))",
          "errorMessage": "@if(startsWith(variables('status'), 'Done-'), '', concat('Incident comment upsert failed with status ', variables('status')))"
        }
      },
      "runAfter": {
        "Condition_Verified": ["Succeeded", "Failed", "TimedOut", "Skipped"]
      }
    }
  },
  "outputs": {}
}